---
// src/components/about/AboutPage.astro

import {
    Activity,
    ArrowRight,
    HeartHandshake,
    MapPin,
    Phone,
    Stethoscope,
} from "@lucide/astro";

import MainLayout from "../../layouts/MainLayout.astro";
import TrustStripShared from "../shared/TrustStripShared.astro";

import { contactInfo } from "../../data/site/contact";
import { ctaNavigation } from "../../data/site/navigation";
import {
    schemaIds,
    getBreadcrumbSchema,
    getGlobalSchema,
    getWebPageSchema,
} from "../../data/seo/schema";
import { teamMetadata } from "../../data/seo/pageMetadata";
import { siteConfig } from "../../data/site/siteConfig";
import {
    getTeamDepartment,
    getTeamMembersByDepartment,
    sortedTeamMembers,
    teamPageContent,
} from "../../data/team/teamMembers";

import type { LanguageCode } from "../../data/site/siteConfig";

interface Props {
    language: LanguageCode;
}

const { language } = Astro.props as Props;

const currentLanguage = language;
const metadata = teamMetadata;

const pageTitle = metadata.title[currentLanguage];
const pageDescription =
    metadata.description[currentLanguage];
const canonicalPath =
    metadata.canonical[currentLanguage];

const leadDoctor =
    sortedTeamMembers.find(
        (member) => member.id === "victor-pazos-md",
    ) ?? sortedTeamMembers[0];

const clinicalDepartment =
    getTeamDepartment("clinical-leadership");

const patientServicesDepartment =
    getTeamDepartment("patient-services");

const diagnosticDepartment =
    getTeamDepartment("diagnostic-services");

const clinicalMembers =
    getTeamMembersByDepartment(
        "clinical-leadership",
    ).filter(
        (member) => member.id !== leadDoctor.id,
    );

const patientServicesMembers =
    getTeamMembersByDepartment("patient-services");

const diagnosticMembers =
    getTeamMembersByDepartment(
        "diagnostic-services",
    );

const memberAnimationDelayClasses = [
    "[animation-delay:0ms]",
    "[animation-delay:70ms]",
    "[animation-delay:140ms]",
    "[animation-delay:210ms]",
    "[animation-delay:280ms]",
    "[animation-delay:350ms]",
    "[animation-delay:420ms]",
    "[animation-delay:490ms]",
    "[animation-delay:560ms]",
];

const getMemberAnimationDelayClass = (
    index: number,
) =>
    memberAnimationDelayClasses[
        Math.min(
            index,
            memberAnimationDelayClasses.length - 1,
        )
    ];

const content = {
    en: {
        heroKicker: "Meet our team",
        heroTitle:
            "The people behind your cardiovascular care.",
        heroDescription:
            teamPageContent.introduction.en,
        heroCallLabel:
            contactInfo.appointment.primaryCta.en,
        heroTeamLabel: "Explore our team",

        introductionKicker:
            "Coordinated patient care",
        introductionTitle:
            "A team working together around every patient.",
        introductionDescription:
            "From cardiovascular evaluations and advanced diagnostic testing to scheduling, referrals, authorizations, and follow-up, every member of the practice contributes to a more organized and personal patient experience.",

        leadershipKicker:
            clinicalDepartment?.label.en ??
            "Clinical leadership",
        leadershipTitle:
            clinicalDepartment?.title.en ??
            "Physicians and advanced clinical care",
        leadershipDescription:
            clinicalDepartment?.description.en ??
            "",

        leadProfileKicker:
            "Medical leadership",
        leadProfilePractice:
            contactInfo.practiceName,

        patientServicesKicker:
            patientServicesDepartment?.label.en ??
            "Patient services",
        patientServicesTitle:
            patientServicesDepartment?.title.en ??
            "Supporting every step of the patient experience",
        patientServicesDescription:
            patientServicesDepartment?.description.en ??
            "",

        diagnosticKicker:
            diagnosticDepartment?.label.en ??
            "Diagnostic services team",
        diagnosticTitle:
            diagnosticDepartment?.title.en ??
            "Advanced cardiovascular diagnostic testing",
        diagnosticDescription:
            diagnosticDepartment?.description.en ??
            "",

        collaborativeKicker:
            "Collaborative care",
        collaborativeTitle:
            teamPageContent.collaborativeCare.title
                .en,
        collaborativeDescription:
            teamPageContent.collaborativeCare
                .description.en,

        commitmentKicker:
            "Our commitment",
        commitmentTitle:
            teamPageContent.commitment.title.en,
        commitmentDescription:
            teamPageContent.commitment.description
                .en,

        appointmentKicker:
            "Request an appointment",
        appointmentTitle:
            "Ready to speak with our cardiology team?",
        appointmentDescription:
            "Call the Hialeah office or submit an appointment request. Our team can assist with scheduling, office information, insurance questions, and the next steps for your cardiovascular evaluation.",
        appointmentButton:
            ctaNavigation.appointment.label.en,
        directionsButton:
            contactInfo.map.directionsLabel.en,

        emergencyNote:
            "If you are experiencing severe chest pain, sudden shortness of breath, fainting, stroke symptoms, or another medical emergency, call 911 immediately.",

        breadcrumbHome: "Home",
        breadcrumbTeam: "Meet Our Team",
        servicesButton: "Explore services",
    },

    es: {
        heroKicker: "Conozca nuestro equipo",
        heroTitle:
            "Las personas detrás de su atención cardiovascular.",
        heroDescription:
            teamPageContent.introduction.es,
        heroCallLabel:
            contactInfo.appointment.primaryCta.es,
        heroTeamLabel: "Conozca el equipo",

        introductionKicker:
            "Atención coordinada",
        introductionTitle:
            "Un equipo trabajando unido alrededor de cada paciente.",
        introductionDescription:
            "Desde evaluaciones cardiovasculares y pruebas diagnósticas avanzadas hasta citas, referidos, autorizaciones y seguimiento, cada miembro de la práctica contribuye a una experiencia más organizada y personal.",

        leadershipKicker:
            clinicalDepartment?.label.es ??
            "Liderazgo clínico",
        leadershipTitle:
            clinicalDepartment?.title.es ??
            "Médicos y atención clínica avanzada",
        leadershipDescription:
            clinicalDepartment?.description.es ??
            "",

        leadProfileKicker:
            "Liderazgo médico",
        leadProfilePractice:
            contactInfo.practiceName,

        patientServicesKicker:
            patientServicesDepartment?.label.es ??
            "Servicios al paciente",
        patientServicesTitle:
            patientServicesDepartment?.title.es ??
            "Apoyando cada etapa de la experiencia del paciente",
        patientServicesDescription:
            patientServicesDepartment?.description.es ??
            "",

        diagnosticKicker:
            diagnosticDepartment?.label.es ??
            "Equipo de servicios diagnósticos",
        diagnosticTitle:
            diagnosticDepartment?.title.es ??
            "Pruebas diagnósticas cardiovasculares avanzadas",
        diagnosticDescription:
            diagnosticDepartment?.description.es ??
            "",

        collaborativeKicker:
            "Atención colaborativa",
        collaborativeTitle:
            teamPageContent.collaborativeCare.title
                .es,
        collaborativeDescription:
            teamPageContent.collaborativeCare
                .description.es,

        commitmentKicker:
            "Nuestro compromiso",
        commitmentTitle:
            teamPageContent.commitment.title.es,
        commitmentDescription:
            teamPageContent.commitment.description
                .es,

        appointmentKicker:
            "Solicitar una cita",
        appointmentTitle:
            "¿Listo para hablar con nuestro equipo de cardiología?",
        appointmentDescription:
            "Llame a la oficina en Hialeah o envíe una solicitud de cita. Nuestro equipo puede ayudar con citas, información de la oficina, preguntas sobre seguros y los próximos pasos de su evaluación cardiovascular.",
        appointmentButton:
            ctaNavigation.appointment.label.es,
        directionsButton:
            contactInfo.map.directionsLabel.es,

        emergencyNote:
            "Si está experimentando dolor fuerte en el pecho, falta de aire repentina, desmayo, síntomas de derrame cerebral u otra emergencia médica, llame al 911 inmediatamente.",

        breadcrumbHome: "Inicio",
        breadcrumbTeam: "Nuestro Equipo",
        servicesButton: "Ver servicios",
    },
};

const t = content[currentLanguage];

const siteUrl = siteConfig.domain.replace(
    /\/$/,
    "",
);

const absoluteUrl = (path: string) =>
    path.startsWith("http://") ||
    path.startsWith("https://")
        ? path
        : `${siteUrl}${path.startsWith("/") ? path : `/${path}`}`;

const teamMemberSchemas =
    sortedTeamMembers.map((member) => {
        const memberSchemaId =
            member.id === "victor-pazos-md"
                ? schemaIds.physician
                : `${absoluteUrl(canonicalPath)}#${member.id}`;

        const organizationRelationship =
            member.id === "brian-valle-do"
                    ? {
                        affiliation: {
                            "@id": schemaIds.organization,
                        },
                    }
                    : {
                        worksFor: {
                            "@id": schemaIds.organization,
                        },
                    };

        return {
            "@context": "https://schema.org",
            "@type": member.schemaType,
            "@id": memberSchemaId,
            name: member.displayName,
            jobTitle:
                member.role[currentLanguage],
            description:
                member.shortBio[currentLanguage],
            image: absoluteUrl(member.image.src),
            url: `${absoluteUrl(canonicalPath)}#${member.id}`,
            ...(member.schemaType === "Physician"
                    ? {
                        medicalSpecialty:
                            "Cardiovascular",
                    }
                    : {}),
            ...organizationRelationship,
        };
    });

const teamItemListSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${absoluteUrl(canonicalPath)}#team`,
    name: t.heroTitle,
    numberOfItems: sortedTeamMembers.length,
    itemListElement:
        sortedTeamMembers.map(
            (member, index) => ({
                "@type": "ListItem",
                position: index + 1,
                item: {
                    "@id":
                        member.id ===
                        "victor-pazos-md"
                            ? schemaIds.physician
                            : `${absoluteUrl(canonicalPath)}#${member.id}`,
                },
            }),
        ),
};

const aboutPageSchema = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${absoluteUrl(canonicalPath)}#about-page`,
    url: absoluteUrl(canonicalPath),
    name: pageTitle,
    description: pageDescription,
    inLanguage:
        currentLanguage === "es"
            ? "es-US"
            : "en-US",
    isPartOf: {
        "@id": schemaIds.website,
    },
    about: {
        "@id": schemaIds.organization,
    },
    mainEntity: {
        "@id": `${absoluteUrl(canonicalPath)}#team`,
    },
};

const breadcrumbSchema =
    getBreadcrumbSchema([
        {
            name: t.breadcrumbHome,
            href:
                currentLanguage === "es"
                    ? "/es/"
                    : "/",
        },
        {
            name: t.breadcrumbTeam,
            href: canonicalPath,
        },
    ]);
---

<MainLayout
    fullTitle
    language={currentLanguage}
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalPath}
    alternateUrls={{
        en: metadata.canonical.en,
        es: metadata.canonical.es,
    }}
    schema={[
        ...getGlobalSchema(),
        getWebPageSchema({
            title: pageTitle,
            description: pageDescription,
            path: canonicalPath,
            language:
                currentLanguage === "es"
                    ? "es-US"
                    : "en-US",
        }),
        breadcrumbSchema,
        aboutPageSchema,
        teamItemListSchema,
        ...teamMemberSchemas,
    ]}
>
    <section
        class="medical-grid-bg section-padding-lg relative isolate overflow-hidden"
    >
        <div
            class="pointer-events-none absolute -left-20 top-[10%] -z-10 aspect-square w-[22rem] rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_24%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="pointer-events-none absolute -right-20 bottom-[10%] -z-10 aspect-square w-[24rem] rounded-full bg-[color-mix(in_srgb,var(--color-heart)_14%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="site-container relative z-10 grid items-center gap-10 lg:grid-cols-2 lg:gap-16"
        >
            <div class="grid content-center">
                <nav
                    class="mb-6 flex flex-wrap items-center gap-2 text-sm font-black text-(--color-text-soft)"
                    aria-label={
                        currentLanguage === "es"
                            ? "Migas de pan"
                            : "Breadcrumb"
                    }
                >
                    <a
                        href={
                            currentLanguage === "es"
                                ? "/es/"
                                : "/"
                        }
                        class="transition-colors hover:text-[var(--color-secondary)]"
                    >
                        {t.breadcrumbHome}
                    </a>

                    <span aria-hidden="true">
                        /
                    </span>

                    <span
                        class="text-[var(--color-heading)]"
                        aria-current="page"
                    >
                        {t.breadcrumbTeam}
                    </span>
                </nav>

                <span class="section-kicker">
                    {t.heroKicker}
                </span>

                <h1
                    class="text-3xl text-(--color-heading) sm:text-4xl lg:text-5xl xl:text-6xl"
                >
                    {t.heroTitle}
                </h1>

                <p
                    class="mt-6 max-w-2xl text-base leading-relaxed text-(--color-text-soft) md:text-lg"
                >
                    {t.heroDescription}
                </p>

                <div
                    class="mt-8 flex flex-wrap gap-3 max-md:grid max-md:w-full"
                >
                    <a
                        href={contactInfo.phone.href}
                        class="btn btn-primary"
                    >
                        <Phone
                            size={18}
                            stroke-width={2}
                            aria-hidden="true"
                        />

                        {t.heroCallLabel}
                    </a>

                    <a
                        href="#team"
                        class="btn btn-secondary"
                    >
                        {t.heroTeamLabel}

                        <ArrowRight
                            size={18}
                            stroke-width={2}
                            aria-hidden="true"
                        />
                    </a>
                </div>
            </div>

            <div
                class="relative mx-auto hidden w-full max-w-180 grid-cols-[1.16fr_0.84fr] gap-3 lg:grid"
                aria-label={t.heroTeamLabel}
            >
                <article
                    class="group relative row-span-2 min-h-140 overflow-hidden rounded-4xl border border-[color-mix(in_srgb,var(--color-secondary)_28%,var(--color-border))] bg-[var(--color-surface)] shadow-[var(--shadow-card)]"
                >
                    <img
                        src={leadDoctor.image.src}
                        alt={
                            leadDoctor.image.alt[
                                currentLanguage
                            ]
                        }
                        width="900"
                        height="1125"
                        loading="eager"
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
                    />

                    <div
                        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[color-mix(in_srgb,var(--color-primary-dark)_94%,transparent)] via-[color-mix(in_srgb,var(--color-primary-dark)_24%,transparent)] to-transparent"
                        aria-hidden="true"
                    >
                    </div>

                    <div
                        class="absolute inset-x-0 bottom-0 z-10 p-6"
                    >
                        <span
                            class="text-xs font-black uppercase tracking-wide text-[var(--color-accent)]"
                        >
                            {
                                leadDoctor.role[
                                    currentLanguage
                                ]
                            }
                        </span>

                        <strong
                            class="mt-2 block font-heading text-3xl text-white xl:text-4xl"
                        >
                            {leadDoctor.displayName}
                        </strong>
                    </div>
                </article>

                {
                    clinicalMembers.map(
                        (member, index) => (
                            <article
                                class:list={[
                                    "group relative min-h-[270px] overflow-hidden rounded-[1.6rem] border border-[color-mix(in_srgb,var(--color-secondary)_24%,var(--color-border))] bg-[var(--color-surface)] shadow-[var(--shadow-card)] animate-fade-up",
                                    getMemberAnimationDelayClass(
                                        index,
                                    ),
                                ]}
                            >
                                <img
                                    src={member.image.src}
                                    alt={
                                        member.image.alt[
                                            currentLanguage
                                        ]
                                    }
                                    width="900"
                                    height="1125"
                                    loading="eager"
                                    decoding="async"
                                    class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none"
                                />

                                <div
                                    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[color-mix(in_srgb,var(--color-primary-dark)_94%,transparent)] via-[color-mix(in_srgb,var(--color-primary-dark)_18%,transparent)] to-transparent"
                                    aria-hidden="true"
                                >
                                </div>

                                <div
                                    class="absolute inset-x-0 bottom-0 z-10 p-4"
                                >
                                    <span
                                        class="text-xs font-black uppercase tracking-wide text-[var(--color-accent)]"
                                    >
                                        {
                                            member.role[
                                                currentLanguage
                                            ]
                                        }
                                    </span>

                                    <strong
                                        class="mt-2 block font-heading text-lg text-white xl:text-xl"
                                    >
                                        {member.displayName}
                                    </strong>
                                </div>
                            </article>
                        ),
                    )
                }
            </div>
        </div>
    </section>

    <section class="section-padding">
        <div
            class="site-container grid items-start gap-10 lg:grid-cols-2 lg:gap-16"
        >
            <div class="max-w-2xl lg:sticky lg:top-28">
                <span class="section-kicker">
                    {t.introductionKicker}
                </span>

                <h2
                    class="text-pretty text-3xl text-[var(--color-heading)] sm:text-4xl lg:text-5xl"
                >
                    {t.introductionTitle}
                </h2>
            </div>

            <div
                class="glow-panel relative overflow-hidden p-6 md:p-8"
            >
                <div
                    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_18%,transparent),transparent_16rem),radial-gradient(circle_at_bottom_left,color-mix(in_srgb,var(--color-heart)_10%,transparent),transparent_15rem)]"
                    aria-hidden="true"
                >
                </div>

                <div class="relative z-10">
                    <HeartHandshake
                        size={42}
                        stroke-width={1.7}
                        class="text-[var(--color-secondary)]"
                        aria-hidden="true"
                    />

                    <p
                        class="mt-6 text-base leading-relaxed text-[var(--color-text-soft)] md:text-lg"
                    >
                        {t.introductionDescription}
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section
        id="team"
        class="section-padding relative isolate overflow-hidden scroll-mt-24"
    >
        <div
            class="pointer-events-none absolute -right-24 top-[10%] -z-10 aspect-square w-[24rem] rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_20%,transparent)] opacity-40 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div class="site-container">
            <div class="max-w-4xl">
                <span class="section-kicker">
                    {t.leadershipKicker}
                </span>

                <h2
                    class="text-pretty text-3xl text-[var(--color-heading)] sm:text-4xl lg:text-5xl"
                >
                    {t.leadershipTitle}
                </h2>

                <p
                    class="mt-5 text-base leading-relaxed text-[var(--color-text-soft)] md:text-lg"
                >
                    {t.leadershipDescription}
                </p>
            </div>

            <article
                id={leadDoctor.id}
                class="medical-card mt-10 scroll-mt-28 overflow-hidden p-0 lg:mt-14"
            >
                <div
                    class="grid lg:grid-cols-[minmax(340px,0.82fr)_minmax(0,1.18fr)]"
                >
                    <div
                        class="relative min-h-[420px] overflow-hidden sm:min-h-[480px] lg:min-h-[520px]"
                    >
                        <img
                            src={leadDoctor.image.src}
                            alt={
                                leadDoctor.image.alt[
                                    currentLanguage
                                ]
                            }
                            width="900"
                            height="1125"
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 h-full w-full object-cover object-center"
                        />

                        <div
                            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[color-mix(in_srgb,var(--color-primary-dark)_72%,transparent)] via-transparent to-transparent"
                            aria-hidden="true"
                        >
                        </div>
                    </div>

                    <div
                        class="relative overflow-hidden p-6 md:p-8 lg:p-12"
                    >
                        <div
                            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_16%,transparent),transparent_17rem),radial-gradient(circle_at_bottom_left,color-mix(in_srgb,var(--color-accent)_10%,transparent),transparent_15rem)]"
                            aria-hidden="true"
                        >
                        </div>

                        <div class="relative z-10">
                            <span class="section-kicker">
                                {t.leadProfileKicker}
                            </span>

                            <h3
                                class="text-3xl text-[var(--color-heading)] md:text-4xl lg:text-5xl"
                            >
                                {leadDoctor.displayName}
                            </h3>

                            <p
                                class="mt-3 font-black text-[var(--color-secondary)]"
                            >
                                {
                                    leadDoctor.role[
                                        currentLanguage
                                    ]
                                }
                            </p>

                            <p
                                class="mt-2 text-sm font-extrabold text-[var(--color-text-soft)]"
                            >
                                {t.leadProfilePractice}
                            </p>

                            <div class="mt-7 grid gap-4">
                                {
                                    leadDoctor.biography[
                                        currentLanguage
                                    ].map(
                                        (paragraph) => (
                                            <p class="text-base leading-relaxed text-[var(--color-text-soft)]">
                                                {paragraph}
                                            </p>
                                        ),
                                    )
                                }
                            </div>

                            <div
                                class="mt-8 flex flex-wrap gap-3 max-md:grid"
                            >
                                <a
                                    href={contactInfo.phone.href}
                                    class="btn btn-primary"
                                >
                                    {t.heroCallLabel}
                                </a>

                                <a
                                    href={
                                        currentLanguage ===
                                        "es"
                                            ? "/es/services/"
                                            : "/services/"
                                    }
                                    class="btn btn-secondary"
                                >
                                    {t.servicesButton}

                                    <ArrowRight
                                        size={18}
                                        stroke-width={2}
                                        aria-hidden="true"
                                    />
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <div
                class="mt-5 grid gap-5 lg:grid-cols-2"
            >
                {
                    clinicalMembers.map(
                        (member, index) => (
                            <article
                                id={member.id}
                                class:list={[
                                    "medical-card group scroll-mt-28 overflow-hidden p-0 animate-fade-up",
                                    getMemberAnimationDelayClass(
                                        index,
                                    ),
                                ]}
                            >
                                <div
                                    class="relative aspect-square overflow-hidden"
                                >
                                    <img
                                        src={member.image.src}
                                        alt={
                                            member.image.alt[
                                                currentLanguage
                                            ]
                                        }
                                        width="900"
                                        height="1125"
                                        loading="lazy"
                                        decoding="async"
                                        class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
                                    />

                                    <div
                                        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[color-mix(in_srgb,var(--color-primary-dark)_70%,transparent)] via-transparent to-transparent"
                                        aria-hidden="true"
                                    >
                                    </div>
                                </div>

                                <div
                                    class="relative overflow-hidden p-6 md:p-7"
                                >
                                    <div
                                        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_13%,transparent),transparent_13rem)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                        aria-hidden="true"
                                    >
                                    </div>

                                    <div class="relative z-10">
                                        <span
                                            class="text-xs font-black uppercase tracking-wide text-[var(--color-secondary)]"
                                        >
                                            {
                                                member.role[
                                                    currentLanguage
                                                ]
                                            }
                                        </span>

                                        <h3
                                            class="mt-2 text-2xl text-[var(--color-heading)] md:text-3xl"
                                        >
                                            {
                                                member.displayName
                                            }
                                        </h3>

                                        <div class="mt-5 grid gap-3">
                                            {
                                                member
                                                    .biography[
                                                    currentLanguage
                                                ].map(
                                                    (
                                                        paragraph,
                                                    ) => (
