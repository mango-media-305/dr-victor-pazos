---
// src/components/home/WhyChooseUs.astro

import { getLanguageFromUrl } from "../../data/i18n/language";
import type { LanguageCode } from "../../data/site/siteConfig";
import { whyChooseUsContent } from "../../data/home/whyChooseUs";

interface Props {
    language?: LanguageCode;
}

const { language } = Astro.props as Props;

const currentLanguage =
    language ?? getLanguageFromUrl(Astro.url.pathname);

const t = whyChooseUsContent;

const animationDelayClasses = [
    "[animation-delay:0ms]",
    "[animation-delay:80ms]",
    "[animation-delay:160ms]",
    "[animation-delay:240ms]",
    "[animation-delay:320ms]",
    "[animation-delay:400ms]",
    "[animation-delay:480ms]",
    "[animation-delay:560ms]",
];

const getAnimationDelayClass = (index: number) =>
    animationDelayClasses[
        Math.min(index, animationDelayClasses.length - 1)
    ];
---

<section
    class="section-padding relative isolate overflow-hidden"
>
    <div
        class="pointer-events-none absolute left-[-5rem] top-[10%] z-[-1] aspect-square w-80 rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_22%,transparent)] opacity-45 blur-[58px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="pointer-events-none absolute bottom-[8%] right-[-5rem] z-[-1] aspect-square w-[22rem] rounded-full bg-[color-mix(in_srgb,var(--color-heart)_14%,transparent)] opacity-45 blur-[58px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="site-container relative z-[1] grid grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] items-start gap-[clamp(2rem,6vw,5rem)] max-[1060px]:grid-cols-1"
    >
        <div
            class="sticky top-28 grid content-start max-[1060px]:relative max-[1060px]:top-auto"
        >
            <span class="section-kicker">
                {t.kicker[currentLanguage]}
            </span>

            <h2
                class="text-[clamp(2.35rem,5.5vw,5rem)] text-[var(--color-heading)]"
            >
                {t.title[currentLanguage]}
            </h2>

            <p
                class="mt-5 text-[clamp(1rem,1.35vw,1.15rem)] text-[var(--color-text-soft)]"
            >
                {t.description[currentLanguage]}
            </p>

            <div
                class="mt-7 flex flex-wrap gap-[0.85rem] max-[720px]:grid"
            >
                <a
                    href={t.cta.href}
                    class="btn btn-primary"
                >
                    {t.cta.label[currentLanguage]}
                </a>

                <a
                    href={t.secondaryCta.href[currentLanguage]}
                    class="btn btn-secondary"
                >
                    {t.secondaryCta.label[currentLanguage]}
                </a>
            </div>
        </div>

        <div
            class="grid grid-cols-2 gap-[0.9rem] max-[720px]:grid-cols-1"
        >
            {
                t.items.map((item, index) => {
                    const Icon = item.icon;

                    return (
                        <article
                            class:list={[
                                "medical-card group relative grid min-h-[17rem] content-start gap-4 overflow-hidden p-[clamp(1.1rem,2vw,1.35rem)] animate-fade-up max-[720px]:min-h-0",
                                getAnimationDelayClass(index),
                            ]}
                        >
                            <div
                                class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_20%,transparent),transparent_13rem),radial-gradient(circle_at_bottom_left,color-mix(in_srgb,var(--color-accent)_14%,transparent),transparent_12rem)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                aria-hidden="true"
                            >
                            </div>

                            <div
                                class="relative z-[1] inline-grid size-[3.2rem] place-items-center rounded-[1.05rem] border border-[color-mix(in_srgb,var(--color-secondary)_32%,var(--color-border))] bg-[radial-gradient(circle_at_top,color-mix(in_srgb,var(--color-secondary)_18%,transparent),transparent_4rem),color-mix(in_srgb,var(--color-surface)_76%,transparent)] text-[var(--color-secondary)] shadow-[0_14px_34px_rgba(15,23,42,0.07)] transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-105"
                                aria-hidden="true"
                            >
                                <Icon
                                    size={24}
                                    strokeWidth={2.15}
                                />
                            </div>

                            <div
                                class="relative z-[1] grid gap-[0.7rem]"
                            >
                                <h3
                                    class="max-w-[280px] font-heading text-[clamp(1.5rem,2.3vw,2.15rem)] text-[var(--color-heading)]"
                                >
                                    {
                                        item.title[
                                            currentLanguage
                                        ]
                                    }
                                </h3>

                                <p
                                    class="text-[0.95rem] text-[var(--color-text-soft)]"
                                >
                                    {
                                        item.description[
                                            currentLanguage
                                        ]
                                    }
                                </p>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
</section>