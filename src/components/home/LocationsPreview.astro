---
// src/components/home/LocationsPreview.astro

import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";

import { getLanguageFromUrl } from "../../data/i18n/language";
import type { LanguageCode } from "../../data/site/siteConfig";
import { contactInfo } from "../../data/site/contact";
import {
    featuredMiamiDadeLocations,
    getMiamiDadeLocationHref,
} from "../../data/locations/miamiDadeLocations";

interface Props {
    language?: LanguageCode;
}

const { language } = Astro.props as Props;

const currentLanguage =
    language ?? getLanguageFromUrl(Astro.url.pathname);

const animationDelayClasses = [
    "[animation-delay:0ms]",
    "[animation-delay:70ms]",
    "[animation-delay:140ms]",
    "[animation-delay:210ms]",
    "[animation-delay:280ms]",
    "[animation-delay:350ms]",
];

const getAnimationDelayClass = (index: number) =>
    animationDelayClasses[
        Math.min(index, animationDelayClasses.length - 1)
    ];

const content = {
    en: {
        kicker: "Areas served",
        title:
            "Cardiology care for patients across Miami-Dade County.",
        description:
            "The main office is located in Hialeah, with convenient access for patients from Miami, Miami Lakes, Doral, Hialeah Gardens, Miami Gardens, and nearby communities.",
        viewAll: "View all locations",
        directions: contactInfo.map.directionsLabel.en,
        officeLabel: "Main office",
        officeName: "Hialeah Office",
        viewLocation: "View location",
        mapTitle:
            "Victor Pazos, MD. PA. office near Palmetto Medical Plaza in Hialeah",
        href: "/locations/",
    },

    es: {
        kicker: "Áreas servidas",
        title:
            "Atención cardiológica para pacientes de Miami-Dade County.",
        description:
            "La oficina principal está ubicada en Hialeah, con acceso conveniente para pacientes de Miami, Miami Lakes, Doral, Hialeah Gardens, Miami Gardens y comunidades cercanas.",
        viewAll: "Ver todas las ubicaciones",
        directions: contactInfo.map.directionsLabel.es,
        officeLabel: "Oficina principal",
        officeName: "Oficina en Hialeah",
        viewLocation: "Ver ubicación",
        mapTitle:
            "Oficina de Victor Pazos, MD. PA. cerca de Palmetto Medical Plaza en Hialeah",
        href: "/es/locations/",
    },
};

const t = content[currentLanguage];

const locations = [...featuredMiamiDadeLocations]
    .sort((a, b) => a.priority - b.priority)
    .slice(0, 6);
---

<section
    class="section-padding relative isolate overflow-hidden"
>
    <div
        class="pointer-events-none absolute right-[-5rem] top-[12%] z-[-1] aspect-square w-[22rem] rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_22%,transparent)] opacity-45 blur-[58px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="pointer-events-none absolute bottom-[10%] left-[-5rem] z-[-1] aspect-square w-72 rounded-full bg-[color-mix(in_srgb,var(--color-accent)_18%,transparent)] opacity-45 blur-[58px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="site-container relative z-[1] grid grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] items-center gap-[clamp(2rem,6vw,5rem)] max-[1060px]:grid-cols-1"
    >
        <div class="grid content-center">
            <span class="section-kicker">
                {t.kicker}
            </span>

            <h2
                class="text-[clamp(2.35rem,5.5vw,5rem)] text-[var(--color-heading)] max-[440px]:text-[clamp(2.25rem,12vw,3.85rem)]"
            >
                {t.title}
            </h2>

            <p
                class="mt-5 text-[clamp(1rem,1.35vw,1.15rem)] text-[var(--color-text-soft)]"
            >
                {t.description}
            </p>

            <div
                class="glow-panel mt-[1.65rem] grid gap-[0.45rem] p-[clamp(1rem,2vw,1.35rem)]"
            >
                <span
                    class="text-xs font-black uppercase text-[var(--color-secondary)]"
                >
                    {t.officeLabel}
                </span>

                <strong
                    class="font-heading text-[clamp(1.6rem,2.6vw,2.35rem)] text-[var(--color-heading)]"
                >
                    {t.officeName}
                </strong>

                <p
                    class="text-[0.96rem] text-[var(--color-text-soft)]"
                >
                    {contactInfo.address.display}
                </p>

                <div
                    class="mt-[0.8rem] flex flex-wrap gap-3 max-[720px]:grid"
                >
                    <a
                        href={contactInfo.map.googleMapsUrl}
                        class="btn btn-primary"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t.directions}
                    </a>

                    <a
                        href={t.href}
                        class="btn btn-secondary"
                    >
                        {t.viewAll}
                    </a>
                </div>
            </div>
        </div>

        <div class="grid gap-4">
            <div
                class="glass-panel-strong relative min-h-[420px] overflow-hidden p-0 max-[1060px]:min-h-[360px] max-[720px]:min-h-[320px]"
            >
                <Image
                    src="/images/hospitals/palmetto-general.webp"
                    width={720}
                    height={480}
                    alt={t.mapTitle}
                    class="absolute inset-0 h-full w-full object-cover contrast-[1.04] saturate-[0.88] dark:brightness-[0.72] dark:contrast-[1.05] dark:saturate-[0.78]"
                    loading="lazy"
                    decoding="async"
                />

                <div
                    class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,color-mix(in_srgb,var(--color-bg)_10%,transparent),color-mix(in_srgb,var(--color-bg)_24%,transparent)),radial-gradient(circle_at_50%_50%,transparent_0%,color-mix(in_srgb,var(--color-bg)_18%,transparent)_72%)]"
                    aria-hidden="true"
                >
                </div>

                <div
                    class="absolute bottom-4 left-4 z-[2] grid w-[min(280px,calc(100%_-_2rem))] gap-1 rounded-[1.25rem] border border-[color-mix(in_srgb,var(--color-secondary)_34%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-surface)_86%,transparent)] px-4 py-[0.95rem] shadow-[var(--shadow-card)] backdrop-blur-[18px] max-[720px]:bottom-3 max-[720px]:left-3 max-[720px]:w-[min(260px,calc(100%_-_1.5rem))]"
                >
                    <span
                        class="text-[0.72rem] font-black uppercase text-[var(--color-text-soft)]"
                    >
                        {t.officeName}
                    </span>

                    <strong
                        class="font-heading text-[1.75rem] text-[var(--color-heading)] max-[720px]:text-2xl max-[440px]:text-[1.4rem]"
                    >
                        Hialeah, FL
                    </strong>
                </div>
            </div>

            <div
                class="grid grid-cols-2 gap-[0.85rem] max-[720px]:grid-cols-1"
            >
                {
                    locations.map((location, index) => (
                        <a
                            href={getMiamiDadeLocationHref(
                                location,
                                currentLanguage,
                            )}
                            class:list={[
                                "medical-card group relative flex min-h-36 justify-between gap-4 overflow-hidden p-4 text-inherit animate-fade-up max-[720px]:min-h-0",
                                getAnimationDelayClass(index),
                            ]}
                            aria-label={`${t.viewLocation}: ${location.title[currentLanguage]}`}
                        >
                            <div
                                class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_18%,transparent),transparent_10rem)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                aria-hidden="true"
                            >
                            </div>

                            <div class="relative z-[1]">
                                <h3
                                    class="font-heading text-[1.45rem] text-[var(--color-heading)]"
                                >
                                    {
                                        location.shortTitle[
                                            currentLanguage
                                        ]
                                    }
                                </h3>

                                <p
                                    class="mt-[0.45rem] text-sm text-[var(--color-text-soft)]"
                                >
                                    {
                                        location
                                            .shortDescription[
                                            currentLanguage
                                        ]
                                    }
                                </p>
                            </div>

                            <span
                                class="relative z-[1] inline-grid size-9 flex-none place-items-center rounded-full border border-[color-mix(in_srgb,var(--color-secondary)_28%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-surface)_78%,transparent)] text-[var(--color-secondary)] transition-[transform,color] duration-200 group-hover:translate-x-[0.2rem] group-hover:text-[var(--color-accent-dark)] dark:group-hover:text-[var(--color-accent)]"
                                aria-hidden="true"
                            >
                                <ArrowRight
                                    size={18}
                                    stroke-width={2}
                                />
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>