---
// src/components/home/HomeHero.astro

import { contactInfo } from "../../data/site/contact";
import { ctaNavigation } from "../../data/site/navigation";
import { getLanguageFromUrl } from "../../data/i18n/language";
import type { LanguageCode } from "../../data/site/siteConfig";

import AnatomicHeart from "../svg/anatomic-heart.astro";

interface Props {
    language?: LanguageCode;
}

const { language } = Astro.props as Props;

const currentLanguage =
    language ?? getLanguageFromUrl(Astro.url.pathname);

const heroBackgroundImages = [
    "/images/home/hero/cardiology-office.webp",
    "/images/home/hero/heart-care-miami.webp",
    "/images/home/hero/doctor-consultation.webp",
    "/images/home/hero/medical-technology.webp",
];

const content = {
    en: {
        eyebrow:
            "Cardiologist in Hialeah serving Miami-Dade",
        title:
            "Heart care with experience, clarity, and personal attention.",
        highlighted: "Victor Pazos, MD.",
        description:
            "Cardiology and interventional cardiology care for patients in Hialeah, Miami, and nearby communities. Call the office to request an appointment.",
        call: ctaNavigation.call.label.en,
        appointment: ctaNavigation.appointment.label.en,
        statOne: "35+",
        statOneLabel: "Years of medical experience",
        statTwo: "Hialeah",
        statTwoLabel: "Serving Miami-Dade patients",
        cardTitle: "Victor Pazos, MD. PA.",
        cardSubtitle: "Cardiology Specialist",
        pulseLabel: "Heart rhythm visual",
        locationLabel: "Office Location",
    },

    es: {
        eyebrow:
            "Cardiólogo en Hialeah sirviendo a Miami-Dade",
        title:
            "Cuidado del corazón con experiencia, claridad y atención personal.",
        highlighted: "Victor Pazos, MD.",
        description:
            "Atención en cardiología y cardiología intervencionista para pacientes en Hialeah, Miami y comunidades cercanas. Llame a la oficina para solicitar una cita.",
        call: ctaNavigation.call.label.es,
        appointment: ctaNavigation.appointment.label.es,
        statOne: "35+",
        statOneLabel: "Años de experiencia médica",
        statTwo: "Hialeah",
        statTwoLabel: "Sirviendo pacientes de Miami-Dade",
        cardTitle: "Victor Pazos, MD. PA.",
        cardSubtitle: "Especialista en cardiología",
        pulseLabel: "Visual de ritmo cardíaco",
        locationLabel: "Ubicación de la oficina",
    },
};

const t = content[currentLanguage];
---

<section
    class="medical-grid-bg section-padding-lg relative isolate -mt-25 overflow-hidden max-[720px]:flex max-[720px]:min-h-svh max-[720px]:items-center"
>
    <div
        class="pointer-events-none absolute inset-0 z-[-4] overflow-hidden"
        aria-hidden="true"
        data-hero-background-slider
    >
        {
            heroBackgroundImages.map((image, index) => (
                <div
                    class:list={[
                        "absolute inset-0 transition-opacity duration-1000 ease-in-out motion-reduce:transition-none",
                        index === 0
                            ? "opacity-[0.22]"
                            : "opacity-0",
                    ]}
                    data-hero-background-slide
                >
                    <img
                        src={image}
                        alt=""
                        class:list={[
                            "absolute inset-0 h-full w-full max-w-none object-cover object-center contrast-[1.05] saturate-[0.9] transition-transform duration-[6000ms] ease-in-out dark:brightness-75 dark:saturate-[0.85] motion-reduce:transition-none",
                            index === 0
                                ? "scale-[1.16]"
                                : "scale-105",
                        ]}
                        data-hero-background-image
                        loading={
                            index === 0 ? "eager" : "lazy"
                        }
                        decoding="async"
                    />
                </div>
            ))
        }
    </div>

    <div
        class="pointer-events-none absolute inset-0 z-[-3] bg-[linear-gradient(90deg,var(--color-bg)_0%,color-mix(in_srgb,var(--color-bg)_88%,transparent)_34%,color-mix(in_srgb,var(--color-bg)_66%,transparent)_62%,color-mix(in_srgb,var(--color-bg)_78%,transparent)_100%),radial-gradient(circle_at_68%_48%,color-mix(in_srgb,var(--color-secondary)_18%,transparent),transparent_30rem),radial-gradient(circle_at_20%_20%,color-mix(in_srgb,var(--color-accent)_12%,transparent),transparent_24rem)] opacity-75 dark:bg-[linear-gradient(90deg,var(--color-bg)_0%,color-mix(in_srgb,var(--color-bg)_88%,transparent)_36%,color-mix(in_srgb,var(--color-bg)_70%,transparent)_64%,color-mix(in_srgb,var(--color-bg)_84%,transparent)_100%),radial-gradient(circle_at_68%_48%,color-mix(in_srgb,var(--color-secondary)_16%,transparent),transparent_30rem),radial-gradient(circle_at_20%_20%,color-mix(in_srgb,var(--color-accent)_10%,transparent),transparent_24rem)] max-[720px]:bg-[linear-gradient(180deg,var(--color-bg)_0%,color-mix(in_srgb,var(--color-bg)_82%,transparent)_42%,var(--color-bg)_100%)]"
        aria-hidden="true"
    >
    </div>

    <div
        class="pointer-events-none absolute left-[4%] top-[8%] z-0 size-72 rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_35%,transparent)] opacity-[0.52] blur-[60px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="pointer-events-none absolute right-[8%] top-[16%] z-0 size-96 rounded-full bg-[color-mix(in_srgb,var(--color-accent)_28%,transparent)] opacity-[0.52] blur-[60px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="pointer-events-none absolute bottom-[10%] right-[28%] z-0 size-72 rounded-full bg-[color-mix(in_srgb,var(--color-heart)_16%,transparent)] opacity-[0.52] blur-[60px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="site-container relative z-[2] grid grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] items-center gap-[clamp(2.5rem,5vw,4.5rem)] max-[1080px]:grid-cols-1 max-[720px]:gap-8 max-[720px]:py-[5rem_3.5rem]"
    >
        <div
            class="grid content-center justify-items-start max-[1080px]:justify-items-center max-[1080px]:text-center max-[720px]:justify-items-start max-[720px]:text-left"
        >
            <span class="eyebrow-pill animate-blur-in">
                <span
                    class="animate-pulse-glow size-[0.55rem] rounded-full bg-[var(--color-heart)] shadow-[0_0_0_4px_color-mix(in_srgb,var(--color-heart)_12%,transparent)] motion-reduce:animate-none"
                    aria-hidden="true"
                >
                </span>

                {t.eyebrow}
            </span>

            <h1
                class="mt-[1.35rem] max-w-[820px] overflow-visible text-5xl text-[var(--color-heading)] animate-fade-up animation-delay-100 md:text-5xl lg:text-6xl"
            >
                {t.title}

                <span
                    class="mt-1 inline-block overflow-visible bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-secondary)] to-[var(--color-accent)] bg-clip-text pb-[0.12em] text-transparent dark:from-[var(--color-heading)]"
                >
                    {t.highlighted}
                </span>
            </h1>

            <p
                class="mt-[1.35rem] max-w-[660px] text-[clamp(1.05rem,1.5vw,1.25rem)] text-[var(--color-text-soft)] animate-fade-up animation-delay-200 max-[1080px]:mx-auto max-[720px]:mx-0"
            >
                {t.description}
            </p>

            <div
                class="mt-8 flex flex-wrap gap-[0.85rem] animate-fade-up animation-delay-300 max-[1080px]:justify-center max-[720px]:w-full max-[720px]:justify-start"
            >
                <a
                    href={contactInfo.phone.href}
                    class="btn btn-primary relative overflow-hidden"
                >
                    <span
                        class="animate-pulse-glow size-[0.65rem] rounded-full bg-current opacity-90 motion-reduce:animate-none"
                        aria-hidden="true"
                    >
                    </span>

                    {t.call}
                </a>

                <a
                    href={
                        ctaNavigation.appointment.href[
                            currentLanguage
                        ]
                    }
                    class="btn btn-secondary"
                >
                    {t.appointment}
                </a>
            </div>
        </div>

        <div
            class="relative flex min-h-[620px] w-full items-center justify-center animate-scale-in animation-delay-200 max-[1080px]:min-h-[560px] max-[720px]:hidden"
        >
            <div
                class="relative mx-auto grid min-h-[620px] w-[min(100%,620px)] place-items-center max-[1080px]:min-h-[560px]"
                aria-label={t.pulseLabel}
            >
                <div
                    class="animate-pulse-glow absolute aspect-square w-[min(90vw,640px)] rounded-full bg-[radial-gradient(circle,color-mix(in_srgb,var(--color-heart)_18%,transparent),transparent_46%),radial-gradient(circle,color-mix(in_srgb,var(--color-secondary)_20%,transparent),transparent_62%),radial-gradient(circle,color-mix(in_srgb,var(--color-accent)_12%,transparent),transparent_76%)] opacity-80 blur-[8px] motion-reduce:animate-none"
                    aria-hidden="true"
                >
                </div>

                <div
                    class="relative grid aspect-square w-[min(100%,500px)] place-items-center overflow-hidden rounded-[42%_58%_52%_48%/45%_43%_57%_55%] border border-[color-mix(in_srgb,var(--color-secondary)_32%,var(--color-border))] bg-[radial-gradient(circle_at_50%_42%,color-mix(in_srgb,var(--color-heart)_14%,transparent),transparent_11rem),radial-gradient(circle_at_52%_48%,color-mix(in_srgb,var(--color-secondary)_24%,transparent),transparent_17rem),linear-gradient(145deg,color-mix(in_srgb,var(--color-surface)_86%,transparent),color-mix(in_srgb,var(--color-surface-soft)_72%,transparent))] shadow-[0_36px_90px_rgba(15,23,42,0.14),inset_0_1px_0_rgba(255,255,255,0.32)] backdrop-blur-3xl dark:shadow-[0_36px_110px_rgba(0,0,0,0.36),inset_0_1px_0_rgba(255,255,255,0.08)] max-[1080px]:w-[min(100%,470px)]"
                >
                    <div
                        class="absolute inset-0 bg-[linear-gradient(to_right,color-mix(in_srgb,var(--color-border)_72%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_srgb,var(--color-border)_72%,transparent)_1px,transparent_1px)] bg-[length:34px_34px] opacity-[0.52] [mask-image:radial-gradient(circle_at_center,black,transparent_70%)]"
                        aria-hidden="true"
                    >
                    </div>

                    <div
                        class="animate-pulse-glow absolute z-0 grid aspect-square w-[960px] place-items-center rounded-full text-[var(--color-heart)] opacity-45 [filter:drop-shadow(0_24px_40px_rgba(15,23,42,0.16))_drop-shadow(0_0_28px_color-mix(in_srgb,var(--color-heart)_18%,transparent))] motion-reduce:animate-none"
                        aria-hidden="true"
                    >
                        <AnatomicHeart
                            class="h-[128%] w-[128%] overflow-visible fill-current text-[var(--color-heart)] [&_.heart-main-layer]:fill-[url(#heartBrandGradient)] [&_.heart-main-layer_path]:fill-[url(#heartBrandGradient)] [&_.heart-main-layer_path]:stroke-none [&_.heart-glow-layer]:fill-[url(#heartBrandGlow)] [&_.heart-glow-layer_ellipse]:fill-[url(#heartBrandGlow)]"
                        />
                    </div>

                    <svg
                        class="pointer-events-none absolute left-1/2 top-1/2 z-[8] w-[128%] -translate-x-1/2 -translate-y-1/2 [filter:drop-shadow(0_0_14px_color-mix(in_srgb,var(--color-accent)_58%,transparent))]"
                        viewBox="0 0 720 180"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path
                            class="stroke-[color-mix(in_srgb,var(--color-accent)_18%,transparent)] stroke-[13px] [stroke-linecap:round] [stroke-linejoin:round]"
                            d="M0 92H150L178 92L205 92L230 32L270 150L305 92H360L385 92L410 62L440 122L470 92H720"
                        >
                        </path>

                        <path
                            class="stroke-[var(--color-accent)] stroke-[5px] [stroke-linecap:round] [stroke-linejoin:round]"
                            d="M0 92H150L178 92L205 92L230 32L270 150L305 92H360L385 92L410 62L440 122L470 92H720"
                        >
                        </path>
                    </svg>

                    <div
                        class="animate-pulse-glow absolute inset-[9%] rounded-[inherit] border border-[color-mix(in_srgb,var(--color-secondary)_35%,transparent)] opacity-0 motion-reduce:animate-none"
                        aria-hidden="true"
                    >
                    </div>

                    <div
                        class="animate-pulse-glow animation-delay-300 absolute inset-[9%] rounded-[inherit] border border-[color-mix(in_srgb,var(--color-secondary)_28%,transparent)] opacity-0 motion-reduce:animate-none"
                        aria-hidden="true"
                    >
                    </div>
                </div>

                <div
                    class="glass-panel absolute bottom-11 right-[20%] z-[9] grid translate-x-1/2 gap-2 p-[1.2rem]"
                >
                    <span
                        class="text-[0.72rem] font-black uppercase text-[var(--color-secondary)]"
                    >
                        {t.cardSubtitle}
                    </span>

                    <strong
                        class="font-heading text-[clamp(1.45rem,2vw,2rem)] text-[var(--color-heading)]"
                    >
                        {t.cardTitle}
                    </strong>

                    <div
                        class="my-1 h-0.5 w-full rounded-full bg-gradient-to-r from-[var(--color-secondary)] via-[var(--color-heart)] to-[var(--color-accent)]"
                        aria-hidden="true"
                    >
                    </div>
                </div>

                <div
                    class="medical-card animate-float-soft absolute left-5 top-[4.25rem] z-[7] grid gap-1 p-4 motion-reduce:animate-none"
                >
                    <strong
                        class="font-heading text-[2.25rem] text-[var(--color-heading)]"
                    >
                        {t.statOne}
                    </strong>

                    <span
                        class="text-[0.82rem] font-extrabold text-[var(--color-text-soft)]"
                    >
                        {t.statOneLabel}
                    </span>
                </div>

                <div
                    class="medical-card floating-card-alt absolute right-1 top-[6.25rem] z-[7] grid gap-1 p-4 motion-reduce:animate-none"
                >
                    <strong
                        class="font-heading text-[2.25rem] text-[var(--color-heading)]"
                    >
                        {t.statTwo}
                    </strong>

                    <span
                        class="text-[0.82rem] font-extrabold text-[var(--color-text-soft)]"
                    >
                        {t.statTwoLabel}
                    </span>
                </div>

                <div
                    class="absolute bottom-[6.25rem] left-8 z-[7] grid gap-[0.15rem] rounded-[1.2rem] border border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-surface)_82%,transparent)] px-4 py-[0.85rem] shadow-[var(--shadow-soft)] backdrop-blur-[18px]"
                >
                    <span
                        class="text-[0.72rem] font-black uppercase text-[var(--color-text-soft)]"
                    >
                        {t.locationLabel}
                    </span>

                    <strong
                        class="text-[0.95rem] font-black text-[var(--color-heading)]"
                    >
                        Hialeah, FL
                    </strong>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    type HeroSliderElement = HTMLElement & {
        heroSliderController?: AbortController;
    };

    const activeSlideClasses = ["opacity-[0.22]"];
    const inactiveSlideClasses = ["opacity-0"];

    const activeImageClasses = ["scale-[1.16]"];
    const inactiveImageClasses = ["scale-105"];

    const toggleClassList = (
        element: HTMLElement,
        classes: string[],
        enabled: boolean,
    ) => {
        classes.forEach((className) => {
            element.classList.toggle(className, enabled);
        });
    };

    const initializeHeroBackgroundSliders = () => {
        const sliders =
            document.querySelectorAll<HeroSliderElement>(
                "[data-hero-background-slider]",
            );

        sliders.forEach((slider) => {
            slider.heroSliderController?.abort();

            const controller = new AbortController();
            slider.heroSliderController = controller;

            const slides = Array.from(
                slider.querySelectorAll<HTMLElement>(
                    "[data-hero-background-slide]",
                ),
            );

            const images = Array.from(
                slider.querySelectorAll<HTMLElement>(
                    "[data-hero-background-image]",
                ),
            );

            if (slides.length <= 1) {
                return;
            }

            const reducedMotionQuery = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            );

            let activeIndex = 0;
            let intervalId: number | undefined;

            const setActiveSlide = (nextIndex: number) => {
                activeIndex =
                    (nextIndex + slides.length) %
                    slides.length;

                slides.forEach((slide, index) => {
                    const isActive = index === activeIndex;

                    toggleClassList(
                        slide,
                        activeSlideClasses,
                        isActive,
                    );

                    toggleClassList(
                        slide,
                        inactiveSlideClasses,
                        !isActive,
                    );
                });

                images.forEach((image, index) => {
                    const isActive = index === activeIndex;

                    toggleClassList(
                        image,
                        activeImageClasses,
                        isActive,
                    );

                    toggleClassList(
                        image,
                        inactiveImageClasses,
                        !isActive,
                    );
                });
            };

            const stopSlider = () => {
                if (intervalId === undefined) {
                    return;
                }

                window.clearInterval(intervalId);
                intervalId = undefined;
            };

            const startSlider = () => {
                stopSlider();

                if (reducedMotionQuery.matches) {
                    setActiveSlide(0);
                    return;
                }

                intervalId = window.setInterval(() => {
                    setActiveSlide(activeIndex + 1);
                }, 6000);
            };

            reducedMotionQuery.addEventListener(
                "change",
                startSlider,
                { signal: controller.signal },
            );

            controller.signal.addEventListener(
                "abort",
                stopSlider,
                { once: true },
            );

            setActiveSlide(0);
            startSlider();
        });
    };

    document.addEventListener(
        "astro:page-load",
        initializeHeroBackgroundSliders,
    );

    initializeHeroBackgroundSliders();
</script>