---
// src/components/home/AboutDoctorPreview.astro

import {
    ArrowRight,
    HeartPulse,
    Languages,
    MapPin,
    Phone,
    Stethoscope,
} from "@lucide/astro";

import { getLanguageFromUrl } from "../../data/i18n/language";
import { doctorProfile } from "../../data/doctor/doctorProfile";
import { aboutMetadata } from "../../data/seo/pageMetadata";
import { contactInfo } from "../../data/site/contact";
import type { LanguageCode } from "../../data/site/siteConfig";

interface Props {
    language?: LanguageCode;
}

const { language } = Astro.props as Props;

const currentLanguage =
    language ?? getLanguageFromUrl(Astro.url.pathname);

const content = {
    en: {
        kicker: "Meet the cardiologist",
        title:
            "Experienced cardiovascular care with clear, bilingual communication.",
        description:
            "Learn more about Victor Pazos, MD and the patient-centered cardiology care available from his Hialeah office.",
        profileLabel: "Doctor profile",
        viewProfile: "Learn more about Dr. Pazos",
        callOffice: "Call the office",
        servingLabel: "Serving Miami-Dade",
        servingText:
            "Care for patients from Hialeah, Miami, Miami Lakes, Doral, and nearby communities.",
    },

    es: {
        kicker: "Conozca al cardiólogo",
        title:
            "Atención cardiovascular con experiencia y comunicación bilingüe clara.",
        description:
            "Conozca más sobre Victor Pazos, MD y la atención cardiológica centrada en el paciente disponible desde su oficina en Hialeah.",
        profileLabel: "Perfil del doctor",
        viewProfile: "Conozca más sobre Dr. Pazos",
        callOffice: "Llamar a la oficina",
        servingLabel: "Sirviendo Miami-Dade",
        servingText:
            "Atención para pacientes de Hialeah, Miami, Miami Lakes, Doral y comunidades cercanas.",
    },
};

const t = content[currentLanguage];

const aboutHref = aboutMetadata.canonical[currentLanguage];

const highlightIcons = [
    HeartPulse,
    Languages,
    MapPin,
    Stethoscope,
];
---

<section
    class="section-padding relative isolate overflow-hidden"
>
    <div
        class="pointer-events-none absolute -left-20 top-[12%] -z-10 aspect-square w-[22rem] rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_22%,transparent)] opacity-45 blur-[58px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="pointer-events-none absolute -right-20 bottom-[10%] -z-10 aspect-square w-[24rem] rounded-full bg-[color-mix(in_srgb,var(--color-heart)_14%,transparent)] opacity-45 blur-[58px]"
        aria-hidden="true"
    >
    </div>

    <div
        class="site-container relative z-10 grid items-center gap-[clamp(2rem,6vw,5rem)] lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)]"
    >
        <div class="grid content-center">
            <span class="section-kicker">
                {t.kicker}
            </span>

            <h2
                class="max-w-[820px] text-[clamp(2.35rem,5.5vw,5rem)] text-[var(--color-heading)] max-[440px]:text-[clamp(2.25rem,12vw,3.85rem)]"
            >
                {t.title}
            </h2>

            <p
                class="mt-5 max-w-[680px] text-[clamp(1rem,1.35vw,1.15rem)] leading-relaxed text-[var(--color-text-soft)]"
            >
                {t.description}
            </p>

            <div
                class="mt-7 flex flex-wrap gap-3 max-[720px]:grid"
            >
                <a
                    href={aboutHref}
                    class="btn btn-primary"
                >
                    {t.viewProfile}

                    <ArrowRight
                        size={18}
                        stroke-width={2}
                        aria-hidden="true"
                    />
                </a>

                <a
                    href={contactInfo.phone.href}
                    class="btn btn-secondary"
                >
                    <Phone
                        size={18}
                        stroke-width={2}
                        aria-hidden="true"
                    />

                    {t.callOffice}
                </a>
            </div>

            <div
                class="glow-panel mt-5 grid gap-2 p-[clamp(1rem,2vw,1.25rem)]"
            >
                <span
                    class="text-xs font-black uppercase tracking-[0.14em] text-[var(--color-secondary)]"
                >
                    {t.servingLabel}
                </span>

                <p
                    class="text-[0.94rem] text-[var(--color-text-soft)]"
                >
                    {t.servingText}
                </p>
            </div>
        </div>

        <article
            class="medical-card group relative overflow-hidden p-[clamp(1.2rem,3vw,2rem)] animate-fade-up"
        >
            <div
                class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_22%,transparent),transparent_16rem),radial-gradient(circle_at_bottom_left,color-mix(in_srgb,var(--color-heart)_12%,transparent),transparent_15rem)]"
                aria-hidden="true"
            >
            </div>

            <div
                class="pointer-events-none absolute -right-12 -top-12 opacity-[0.07]"
                aria-hidden="true"
            >
                <HeartPulse
                    size={220}
                    stroke-width={1.15}
                    class="text-[var(--color-secondary)]"
                />
            </div>

            <div class="relative z-10 grid gap-6">
                <div
                    class="flex items-start justify-between gap-5 max-[560px]:grid"
                >
                    <div class="grid gap-2">
                        <span
                            class="text-xs font-black uppercase tracking-[0.14em] text-[var(--color-secondary)]"
                        >
                            {t.profileLabel}
                        </span>

                        <h3
                            class="font-heading text-[clamp(2rem,4.4vw,3.6rem)] leading-[0.95] text-[var(--color-heading)]"
                        >
                            {doctorProfile.displayName}
                        </h3>

                        <p
                            class="font-black text-[var(--color-secondary)]"
                        >
                            {
                                doctorProfile.specialty[
                                    currentLanguage
                                ]
                            }
                        </p>
                    </div>

                    <div
                        class="inline-grid size-16 flex-none place-items-center rounded-[1.35rem] border border-[color-mix(in_srgb,var(--color-secondary)_34%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-secondary-soft)_48%,transparent)] text-[var(--color-secondary)] shadow-[var(--shadow-soft)]"
                        aria-hidden="true"
                    >
                        <Stethoscope
                            size={30}
                            stroke-width={1.9}
                        />
                    </div>
                </div>

                <p
                    class="max-w-[720px] text-[0.98rem] leading-relaxed text-[var(--color-text-soft)]"
                >
                    {doctorProfile.shortBio[currentLanguage]}
                </p>

                <div
                    class="grid grid-cols-2 gap-3 max-[560px]:grid-cols-1"
                >
                    {
                        doctorProfile.highlights
                            .slice(0, 4)
                            .map((item, index) => {
                                const Icon =
                                    highlightIcons[index] ??
                                    Stethoscope;

                                return (
                                    <div class="relative overflow-hidden rounded-[1.35rem] border border-[color-mix(in_srgb,var(--color-border)_84%,transparent)] bg-[color-mix(in_srgb,var(--color-surface)_76%,transparent)] p-4">
                                        <div
                                            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_13%,transparent),transparent_8rem)]"
                                            aria-hidden="true"
                                        >
                                        </div>

                                        <div class="relative z-10">
                                            <div class="flex items-start justify-between gap-3">
                                                <span
                                                    class="font-heading text-[clamp(1.55rem,3vw,2.25rem)] font-extrabold text-[var(--color-heading)]"
                                                >
                                                    {item.value}
                                                </span>

                                                <Icon
                                                    size={21}
                                                    stroke-width={2}
                                                    class="flex-none text-[var(--color-secondary)]"
                                                    aria-hidden="true"
                                                />
                                            </div>

                                            <p
                                                class="mt-3 text-xs font-black uppercase tracking-[0.08em] text-[var(--color-secondary)]"
                                            >
                                                {
                                                    item.label[
                                                        currentLanguage
                                                    ]
                                                }
                                            </p>
                                        </div>
                                    </div>
                                );
                            })
                    }
                </div>

                <a
                    href={aboutHref}
                    class="group/link inline-flex w-fit items-center gap-2 font-black text-[var(--color-secondary)] transition-colors hover:text-[var(--color-accent-dark)] dark:hover:text-[var(--color-accent)]"
                    aria-label={`${t.viewProfile}: ${doctorProfile.displayName}`}
                >
                    {t.viewProfile}

                    <ArrowRight
                        size={18}
                        stroke-width={2}
                        class="transition-transform duration-200 group-hover/link:translate-x-1"
                        aria-hidden="true"
                    />
                </a>
            </div>
        </article>
    </div>
</section>