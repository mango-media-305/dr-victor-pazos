---
// src/components/services/ServicesIndexPage.astro

import { ArrowRight, MapPin, Phone } from "lucide-astro";

import MainLayout from "../../layouts/MainLayout.astro";
import {
    cardiologyServices,
    getCardiologyServiceHref,
} from "../../data/services/cardiologyServices";
import { contactInfo } from "../../data/site/contact";
import { servicesIndexMetadata } from "../../data/seo/pageMetadata";
import {
    getGlobalSchema,
    getWebPageSchema,
} from "../../data/seo/schema";
import type { LanguageCode } from "../../data/site/siteConfig";

interface Props {
    language: LanguageCode;
}

const { language } = Astro.props as Props;

const currentLanguage = language;
const metadata = servicesIndexMetadata;

const heroFloatingImage =
    "/images/services/cardiology-services-floating.webp";

const services = [...cardiologyServices].sort(
    (a, b) => a.priority - b.priority,
);

const serviceAnimationDelayClasses = [
    "[animation-delay:0ms]",
    "[animation-delay:80ms]",
    "[animation-delay:160ms]",
    "[animation-delay:240ms]",
    "[animation-delay:320ms]",
    "[animation-delay:400ms]",
    "[animation-delay:480ms]",
    "[animation-delay:560ms]",
    "[animation-delay:640ms]",
    "[animation-delay:720ms]",
    "[animation-delay:800ms]",
    "[animation-delay:880ms]",
    "[animation-delay:960ms]",
    "[animation-delay:1040ms]",
    "[animation-delay:1120ms]",
];

const getServiceAnimationDelayClass = (index: number) =>
    serviceAnimationDelayClasses[
        Math.min(
            index,
            serviceAnimationDelayClasses.length - 1,
        )
    ];

const content = {
    kicker: "Cardiology services",
    title:
        "Cardiology care for symptoms, testing, prevention, and ongoing heart conditions.",
    description:
        "Explore cardiology services available through Victor Pazos, MD. PA. in Hialeah, FL, serving patients across Miami-Dade County.",

    introKicker: "Patient-focused care",
    introTitle:
        "Heart care starts with understanding what you need.",
    introDescription:
        "Patients may contact a cardiologist for symptoms such as chest discomfort, palpitations, shortness of breath, high blood pressure, abnormal EKG results, or known heart disease. These service pages are designed to help patients understand common reasons to seek cardiology evaluation and how the office may help.",

    callLabel: contactInfo.appointment.primaryCta.en,
    directionsLabel: contactInfo.map.directionsLabel.en,
    viewService: "Explore service",

    emergencyNote:
        "If you are experiencing severe chest pain, sudden shortness of breath, fainting, stroke symptoms, or a medical emergency, call 911 immediately.",

    bottomKicker: "Request an appointment",
    bottomTitle:
        "Need help choosing the right cardiology service?",
    bottomDescription:
        "Call the office to request an appointment or ask which type of cardiology evaluation may be appropriate for your concern.",
};
---

<MainLayout
    fullTitle
    language={currentLanguage}
    title={metadata.title[currentLanguage]}
    description={metadata.description[currentLanguage]}
    canonical={metadata.canonical[currentLanguage]}
    alternateUrls={{
        en: metadata.canonical.en,
        es: metadata.canonical.es,
    }}
    schema={[
        ...getGlobalSchema(),
        getWebPageSchema({
            title: metadata.title[currentLanguage],
            description: metadata.description[currentLanguage],
            path: metadata.canonical[currentLanguage],
        }),
    ]}
>
    <section
        class="medical-grid-bg section-padding-lg relative isolate overflow-hidden"
    >
        <div
            class="pointer-events-none absolute -left-20 top-[12%] -z-10 aspect-square w-[22rem] rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_24%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="pointer-events-none absolute -right-20 bottom-[12%] -z-10 aspect-square w-[24rem] rounded-full bg-[color-mix(in_srgb,var(--color-heart)_14%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="site-container relative z-10 grid items-center gap-[clamp(2rem,6vw,5rem)] lg:grid-cols-2"
        >
            <div class="grid content-center">
                <span class="section-kicker">
                    {content.kicker}
                </span>

                <h1
                    class="text-[clamp(2rem,7vw,5rem)] text-[var(--color-heading)]"
                >
                    {content.title}
                </h1>

                <p
                    class="mt-5 max-w-[760px] text-[clamp(1.05rem,1.5vw,1.22rem)] text-[var(--color-text-soft)]"
                >
                    {content.description}
                </p>

                <div
                    class="mt-8 flex flex-wrap gap-3 max-md:grid max-md:w-full"
                >
                    <a
                        href={contactInfo.phone.href}
                        class="btn btn-primary"
                    >
                        <Phone
                            size={18}
                            strokeWidth={2}
                            aria-hidden="true"
                        />

                        {content.callLabel}
                    </a>

                    <a
                        href={contactInfo.map.googleMapsUrl}
                        class="btn btn-secondary"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <MapPin
                            size={18}
                            strokeWidth={2}
                            aria-hidden="true"
                        />

                        {content.directionsLabel}
                    </a>
                </div>
            </div>

            <div
                class="relative mx-auto hidden w-full max-w-[420px] md:block lg:mx-0"
            >
                <div
                    class="pointer-events-none absolute -inset-6 rounded-[2.5rem] bg-[color-mix(in_srgb,var(--color-secondary)_18%,transparent)] blur-3xl"
                    aria-hidden="true"
                >
                </div>

                <div
                    class="animate-float-soft relative aspect-4/5 overflow-hidden rounded-[2rem] motion-reduce:animate-none"
                >
                    <img
                        src={heroFloatingImage}
                        alt="Cardiology care and heart health evaluation"
                        class="h-full w-full object-cover"
                        loading="eager"
                        decoding="async"
                    />
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding-sm">
        <div
            class="site-container glow-panel grid items-end gap-[clamp(1.25rem,4vw,3rem)] p-[clamp(1.25rem,3vw,2rem)]"
        >
            <div>
                <span class="section-kicker">
                    {content.introKicker}
                </span>

                <h2
                    class="text-[clamp(2.1rem,4.8vw,4.4rem)] text-[var(--color-heading)]"
                >
                    {content.introTitle}
                </h2>
            </div>

            <p
                class="text-[clamp(1rem,1.35vw,1.12rem)] text-(--color-text-soft)"
            >
                {content.introDescription}
            </p>
        </div>
    </section>

    <section
        class="section-padding relative isolate overflow-hidden"
    >
        <div
            class="pointer-events-none absolute -right-20 top-[10%] -z-10 aspect-square w-[22rem] rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_22%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="pointer-events-none absolute -left-20 bottom-[8%] -z-10 aspect-square w-[20rem] rounded-full bg-[color-mix(in_srgb,var(--color-heart)_14%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div class="site-container">
            <div
                class="relative z-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3"
            >
                {
                    services.map((service, index) => {
                        const Icon = service.icon;

                        return (
                            <a
                                href={getCardiologyServiceHref(
                                    service,
                                    currentLanguage,
                                )}
                                class:list={[
                                    "medical-card group relative grid min-h-72 content-between overflow-hidden p-[clamp(1.25rem,2.4vw,1.65rem)] text-inherit animate-fade-up max-[680px]:min-h-0",
                                    getServiceAnimationDelayClass(
                                        index,
                                    ),
                                ]}
                                aria-label={`${content.viewService}: ${service.title[currentLanguage]}`}
                            >
                                <Icon
                                    class="pointer-events-none absolute -right-5 -top-5 h-32 w-32 text-[var(--color-secondary)] opacity-[0.08] transition-[transform,opacity] duration-300 group-hover:scale-110 group-hover:opacity-[0.13] max-[680px]:h-28 max-[680px]:w-28"
                                    aria-hidden="true"
                                />

                                <div
                                    class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-[var(--color-secondary)] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-70"
                                    aria-hidden="true"
                                >
                                </div>

                                <div
                                    class="relative z-[1] mt-[3.3rem] grid gap-3 max-[680px]:mt-9"
                                >
                                    <h3
                                        class="font-heading text-[clamp(1.45rem,2.1vw,2rem)] leading-none text-[var(--color-heading)]"
                                    >
                                        {
                                            service.shortTitle[
                                                currentLanguage
                                            ]
                                        }
                                    </h3>

                                    <p
                                        class="max-w-[30rem] text-[0.98rem] leading-relaxed text-[var(--color-text-soft)]"
                                    >
                                        {
                                            service
                                                .shortDescription[
                                                currentLanguage
                                            ]
                                        }
                                    </p>
                                </div>

                                <span
                                    class="relative z-[1] mt-[1.6rem] inline-flex w-fit items-center gap-[0.45rem] text-[0.82rem] font-black uppercase tracking-[0.12em] text-[var(--color-secondary)] transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-[var(--color-accent-dark)] dark:group-hover:text-[var(--color-accent)]"
                                >
                                    {content.viewService}

                                    <ArrowRight
                                        size={18}
                                        strokeWidth={2}
                                        aria-hidden="true"
                                    />
                                </span>
                            </a>
                        );
                    })
                }
            </div>

            <p
                class="relative z-10 mt-[clamp(1.25rem,3vw,2rem)] rounded-[1.25rem] border border-[color-mix(in_srgb,var(--color-heart)_28%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-heart-soft)_38%,transparent)] p-4 text-sm font-extrabold text-[var(--color-heart)]"
            >
                {content.emergencyNote}
            </p>
        </div>
    </section>

    <section class="section-padding-sm">
        <div class="site-container">
            <div
                class="glow-panel grid items-center gap-5 p-[clamp(1.25rem,3vw,2rem)] lg:grid-cols-[1fr_auto]"
            >
                <div>
                    <span class="section-kicker">
                        {content.bottomKicker}
                    </span>

                    <h2
                        class="text-[clamp(2rem,4vw,3.75rem)] text-[var(--color-heading)]"
                    >
                        {content.bottomTitle}
                    </h2>

                    <p
                        class="mt-3 max-w-[720px] text-base text-[var(--color-text-soft)]"
                    >
                        {content.bottomDescription}
                    </p>
                </div>

                <a
                    href={contactInfo.phone.href}
                    class="btn btn-primary max-lg:w-fit max-md:w-full"
                >
                    {content.callLabel}
                </a>
            </div>
        </div>
    </section>
</MainLayout>