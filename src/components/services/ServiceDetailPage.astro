---
// src/components/services/ServiceDetailPage.astro

import MainLayout from "../../layouts/MainLayout.astro";
import { contactInfo } from "../../data/site/contact";
import {
    getCardiologyServiceHref,
    getRelatedCardiologyServices,
    type CardiologyService,
} from "../../data/services/cardiologyServices";
import {
    getGlobalSchema,
    getWebPageSchema,
} from "../../data/seo/schema";
import type { LanguageCode } from "../../data/site/siteConfig";

interface Props {
    service: CardiologyService;
    language: LanguageCode;
}

const { service, language } = Astro.props as Props;

const currentLanguage = language;
const serviceImages = service.detailImages.slice(0, 3);
const relatedServices = getRelatedCardiologyServices(service.id, 3);

const animationDelayClasses = [
    "[animation-delay:0ms]",
    "[animation-delay:80ms]",
    "[animation-delay:160ms]",
    "[animation-delay:240ms]",
    "[animation-delay:320ms]",
    "[animation-delay:400ms]",
    "[animation-delay:480ms]",
    "[animation-delay:560ms]",
    "[animation-delay:640ms]",
    "[animation-delay:720ms]",
];

const getAnimationDelayClass = (index: number) =>
    animationDelayClasses[
        Math.min(index, animationDelayClasses.length - 1)
    ];

const content = {
    en: {
        servicesLabel: "Services",
        overviewLabel: "Service overview",
        reasonsKicker: "Reasons to seek care",
        reasonsTitle:
            "Common reasons patients request this cardiology service.",
        expectKicker: "What to expect",
        expectTitle:
            "A clear visit process focused on your heart health.",
        faqKicker: "Service FAQ",
        faqTitle:
            "Questions patients often ask about this service.",
        relatedKicker: "Related services",
        relatedTitle:
            "Other cardiology services that may be helpful.",
        exploreService: "Explore service",
        callLabel: contactInfo.appointment.primaryCta.en,
        directionsLabel: contactInfo.map.directionsLabel.en,
        appointmentKicker: "Request an appointment",
        appointmentTitle: "Have questions about this service?",
        appointmentDescription:
            "Call the office to request an appointment or ask whether this type of cardiology evaluation may be appropriate for your concern.",
        emergencyNote:
            "If you are experiencing severe chest pain, sudden shortness of breath, fainting, stroke symptoms, or a medical emergency, call 911 immediately.",
        backHref: "/services/",
        galleryLabel: `${service.shortTitle.en} image gallery`,
        showImageLabel: "Show image",
    },
    es: {
        servicesLabel: "Servicios",
        overviewLabel: "Resumen del servicio",
        reasonsKicker: "Razones para buscar atención",
        reasonsTitle:
            "Razones comunes por las que los pacientes solicitan este servicio cardiológico.",
        expectKicker: "Qué esperar",
        expectTitle:
            "Un proceso claro enfocado en la salud de su corazón.",
        faqKicker: "Preguntas frecuentes",
        faqTitle:
            "Preguntas que los pacientes suelen hacer sobre este servicio.",
        relatedKicker: "Servicios relacionados",
        relatedTitle:
            "Otros servicios de cardiología que pueden ser útiles.",
        exploreService: "Explorar servicio",
        callLabel: contactInfo.appointment.primaryCta.es,
        directionsLabel: contactInfo.map.directionsLabel.es,
        appointmentKicker: "Solicitar una cita",
        appointmentTitle: "¿Tiene preguntas sobre este servicio?",
        appointmentDescription:
            "Llame a la oficina para solicitar una cita o preguntar si este tipo de evaluación cardiológica puede ser apropiada para su preocupación.",
        emergencyNote:
            "Si está experimentando dolor fuerte en el pecho, falta de aire repentina, desmayo, síntomas de derrame cerebral o una emergencia médica, llame al 911 inmediatamente.",
        backHref: "/es/services/",
        galleryLabel: `Galería de imágenes de ${service.shortTitle.es}`,
        showImageLabel: "Mostrar imagen",
    },
};

const t = content[currentLanguage];

const pageTitle = service.seo.title[currentLanguage];
const pageDescription = service.seo.description[currentLanguage];
const canonicalPath = service.href[currentLanguage];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: service.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question[currentLanguage],
        acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer[currentLanguage],
        },
    })),
};

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    name: service.title[currentLanguage],
    description: service.description[currentLanguage],
    areaServed: "Miami-Dade County",
    address: {
        "@type": "PostalAddress",
        streetAddress: `${contactInfo.address.street} ${contactInfo.address.suite}`,
        addressLocality: contactInfo.address.city,
        addressRegion: contactInfo.address.state,
        postalCode: contactInfo.address.zip,
        addressCountry: contactInfo.address.country,
    },
    telephone: contactInfo.phone.raw,
    medicalSpecialty: "Cardiovascular",
};
---

<MainLayout
    fullTitle
    language={currentLanguage}
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalPath}
    alternateUrls={{
        en: service.href.en,
        es: service.href.es,
    }}
    schema={[
        ...getGlobalSchema(),
        getWebPageSchema({
            title: pageTitle,
            description: pageDescription,
            path: canonicalPath,
        }),
        serviceSchema,
        faqSchema,
    ]}
>
    <section
        class="medical-grid-bg section-padding-lg relative isolate overflow-hidden"
    >
        <div
            class="pointer-events-none absolute -left-20 top-[12%] -z-10 aspect-square w-88 rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_24%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="pointer-events-none absolute -right-20 bottom-[12%] -z-10 aspect-square w-[24rem] rounded-full bg-[color-mix(in_srgb,var(--color-heart)_14%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="site-container relative z-10 grid items-center gap-[clamp(2rem,6vw,5rem)] lg:grid-cols-2"
        >
            <div class="grid content-center">
                <nav
                    class="mb-6 flex flex-wrap items-center gap-2 text-sm font-black text-(--color-text-soft)"
                >
                    <a
                        href={t.backHref}
                        class="transition-colors hover:text-(--color-secondary)"
                    >
                        {t.servicesLabel}
                    </a>

                    <span aria-hidden="true">/</span>

                    <span class="text-(--color-heading)">
                        {service.shortTitle[currentLanguage]}
                    </span>
                </nav>

                <span class="section-kicker">
                    {service.shortTitle[currentLanguage]}
                </span>

                <h1
                    class="max-w-245 text-7xl text-(--color-heading) max-[440px]:text-[clamp(2.75rem,15vw,4.25rem)]"
                >
                    {service.title[currentLanguage]}
                </h1>

                <p
                    class="mt-5 max-w-[760px] text-[clamp(1.05rem,1.5vw,1.22rem)] text-(--color-text-soft)"
                >
                    {service.description[currentLanguage]}
                </p>

                <div
                    class="mt-8 flex flex-wrap gap-3 max-md:grid max-md:w-full"
                >
                    <a
                        href={contactInfo.phone.href}
                        class="btn btn-primary"
                    >
                        {t.callLabel}
                    </a>

                    <a
                        href={contactInfo.map.googleMapsUrl}
                        class="btn btn-secondary"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t.directionsLabel}
                    </a>
                </div>
            </div>

            <div class="relative mx-auto w-full max-w-105 lg:mx-0">
                <div
                    class="pointer-events-none absolute -inset-6 rounded-[2.5rem] bg-[color-mix(in_srgb,var(--color-secondary)_18%,transparent)] blur-3xl"
                    aria-hidden="true"
                >
                </div>

                <div
                    class="relative aspect-4/5 overflow-hidden rounded-4xl border border-[color-mix(in_srgb,var(--color-secondary)_28%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-surface)_76%,transparent)] shadow-(--shadow-card)"
                    data-service-slider
                    aria-label={t.galleryLabel}
                >
                    {
                        serviceImages.map((image, index) => (
                            <figure
                                class:list={[
                                    "absolute inset-0 transition-[opacity,transform] duration-700 ease-in-out motion-reduce:transition-none",
                                    index === 0
                                        ? "z-[1] scale-100 opacity-100"
                                        : "z-0 scale-105 opacity-0",
                                ]}
                                data-service-slide
                                aria-hidden={
                                    index === 0 ? "false" : "true"
                                }
                            >
                                <img
                                    src={image.src}
                                    alt={image.alt[currentLanguage]}
                                    class="h-full w-full object-cover"
                                    loading={
                                        index === 0 ? "eager" : "lazy"
                                    }
                                    decoding="async"
                                />
                            </figure>
                        ))
                    }

                    <div
                        class="pointer-events-none absolute inset-0 z-[2] bg-[radial-gradient(circle_at_50%_28%,transparent,color-mix(in_srgb,var(--color-bg)_18%,transparent)_72%)]"
                        aria-hidden="true"
                    >
                    </div>

                    {
                        serviceImages.length > 1 && (
                            <div
                                class="absolute left-4 top-4 z-10 flex gap-2"
                                role="tablist"
                                aria-label={t.galleryLabel}
                            >
                                {serviceImages.map((_, index) => (
                                    <button
                                        type="button"
                                        class:list={[
                                            "block h-1.5 w-8 origin-left rounded-full transition-[transform,opacity,background-color] duration-300 motion-reduce:transition-none",
                                            index === 0
                                                ? "scale-x-100 bg-white opacity-100"
                                                : "scale-x-50 bg-white/45 opacity-60",
                                        ]}
                                        data-service-dot
                                        role="tab"
                                        aria-label={`${t.showImageLabel} ${index + 1}`}
                                        aria-selected={
                                            index === 0
                                                ? "true"
                                                : "false"
                                        }
                                        tabindex={
                                            index === 0 ? 0 : -1
                                        }
                                    />
                                ))}
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding-sm">
        <div
            class="site-container glow-panel grid items-start gap-[clamp(1.25rem,4vw,3rem)] p-[clamp(1.25rem,3vw,2rem)] max-md:rounded-[1.65rem]"
        >
            <div>
                <span class="section-kicker">{t.overviewLabel}</span>

                <h2
                    class="max-w-[640px] text-[clamp(2.1rem,4.8vw,4.4rem)] text-[var(--color-heading)]"
                >
                    {service.shortTitle[currentLanguage]}
                </h2>
            </div>

            <p
                class="text-[clamp(1rem,1.35vw,1.12rem)] text-[var(--color-text-soft)]"
            >
                {service.overview[currentLanguage]}
            </p>
        </div>
    </section>

    <section
        class="section-padding relative isolate overflow-hidden"
    >
        <div
            class="pointer-events-none absolute -right-20 top-[10%] -z-10 aspect-square w-[22rem] rounded-full bg-[color-mix(in_srgb,var(--color-secondary)_22%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div class="site-container">
            <div
                class="mb-[clamp(1.75rem,4vw,3rem)] grid gap-[clamp(1rem,4vw,3rem)]"
            >
                <div>
                    <span class="section-kicker">
                        {t.reasonsKicker}
                    </span>

                    <h2
                        class="text-[clamp(2.25rem,5vw,4.8rem)] text-[var(--color-heading)]"
                    >
                        {t.reasonsTitle}
                    </h2>
                </div>

                <p
                    class="text-[clamp(1rem,1.35vw,1.12rem)] text-[var(--color-text-soft)]"
                >
                    {service.shortDescription[currentLanguage]}
                </p>
            </div>

            <div class="grid gap-4 md:grid-cols-3">
                {
                    service.reasonsToSeekCare.map(
                        (item, index) => (
                            <article
                                class:list={[
                                    "medical-card group relative min-h-64 overflow-hidden p-[clamp(1rem,2vw,1.25rem)] animate-fade-up max-md:min-h-0",
                                    getAnimationDelayClass(index),
                                ]}
                            >
                                <div
                                    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-heart)_16%,transparent),transparent_12rem),radial-gradient(circle_at_bottom_left,color-mix(in_srgb,var(--color-secondary)_14%,transparent),transparent_12rem)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                    aria-hidden="true"
                                >
                                </div>

                                <div class="relative z-10">
                                    <span
                                        class="font-heading text-4xl font-extrabold text-[color-mix(in_srgb,var(--color-accent)_76%,var(--color-text-muted))] opacity-60"
                                    >
                                        {
                                            String(index + 1).padStart(
                                                2,
                                                "0",
                                            )
                                        }
                                    </span>

                                    <h3
                                        class="mt-8 font-heading text-[clamp(1.45rem,2.4vw,2.15rem)] text-[var(--color-heading)]"
                                    >
                                        {
                                            item.title[
                                                currentLanguage
                                            ]
                                        }
                                    </h3>

                                    <p
                                        class="mt-3 text-base text-[var(--color-text-soft)]"
                                    >
                                        {
                                            item.description[
                                                currentLanguage
                                            ]
                                        }
                                    </p>
                                </div>
                            </article>
                        ),
                    )
                }
            </div>

            <p
                class="mt-[clamp(1.25rem,3vw,2rem)] rounded-[1.25rem] border border-[color-mix(in_srgb,var(--color-heart)_28%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-heart-soft)_38%,transparent)] p-4 text-sm font-extrabold text-[var(--color-heart)]"
            >
                {t.emergencyNote}
            </p>
        </div>
    </section>

    <section class="section-padding">
        <div
            class="site-container grid gap-[clamp(2rem,6vw,5rem)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
        >
            <div class="lg:sticky lg:top-28 lg:self-start">
                <span class="section-kicker">
                    {t.expectKicker}
                </span>

                <h2
                    class="max-w-[720px] text-[clamp(2.25rem,5vw,4.8rem)] text-[var(--color-heading)]"
                >
                    {t.expectTitle}
                </h2>
            </div>

            <div
                class="relative grid gap-4 before:absolute before:bottom-4 before:left-6 before:top-4 before:w-px before:bg-[linear-gradient(180deg,transparent,color-mix(in_srgb,var(--color-secondary)_38%,var(--color-border)),color-mix(in_srgb,var(--color-accent)_34%,var(--color-border)),transparent)] before:content-['']"
            >
                {
                    service.whatToExpect.map((item, index) => (
                        <article
                            class:list={[
                                "medical-card relative grid grid-cols-[auto_1fr] gap-4 overflow-hidden p-[clamp(1rem,2vw,1.2rem)] animate-fade-up",
                                getAnimationDelayClass(index),
                            ]}
                        >
                            <span
                                class="relative z-10 grid size-12 place-items-center rounded-2xl border border-[color-mix(in_srgb,var(--color-secondary)_34%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-surface)_86%,transparent)] font-heading text-lg font-extrabold text-[var(--color-secondary)] shadow-[0_14px_34px_rgba(15,23,42,0.07)]"
                            >
                                {
                                    String(index + 1).padStart(
                                        2,
                                        "0",
                                    )
                                }
                            </span>

                            <div class="relative z-10">
                                <h3
                                    class="font-heading text-[clamp(1.35rem,2vw,1.85rem)] text-[var(--color-heading)]"
                                >
                                    {item.title[currentLanguage]}
                                </h3>

                                <p
                                    class="mt-2 text-[0.96rem] text-[var(--color-text-soft)]"
                                >
                                    {
                                        item.description[
                                            currentLanguage
                                        ]
                                    }
                                </p>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section
        class="section-padding relative isolate overflow-hidden"
    >
        <div
            class="pointer-events-none absolute -left-20 bottom-[8%] -z-10 aspect-square w-[20rem] rounded-full bg-[color-mix(in_srgb,var(--color-heart)_14%,transparent)] opacity-45 blur-[58px]"
            aria-hidden="true"
        >
        </div>

        <div
            class="site-container grid gap-[clamp(2rem,6vw,5rem)] lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)]"
        >
            <div class="lg:sticky lg:top-28 lg:self-start">
                <span class="section-kicker">{t.faqKicker}</span>

                <h2
                    class="max-w-[720px] text-[clamp(2.25rem,5vw,4.8rem)] text-[var(--color-heading)]"
                >
                    {t.faqTitle}
                </h2>
            </div>

            <div class="grid gap-4">
                {
                    service.faqs.map((faq, index) => (
                        <details
                            class:list={[
                                "medical-card group overflow-hidden p-0 animate-fade-up",
                                getAnimationDelayClass(index),
                            ]}
                            open={index === 0}
                        >
                            <summary
                                class="flex cursor-pointer list-none items-center justify-between gap-4 p-[clamp(1rem,2vw,1.2rem)] [&::-webkit-details-marker]:hidden"
                            >
                                <span
                                    class="font-heading text-[clamp(1.25rem,2vw,1.65rem)] font-extrabold text-[var(--color-heading)]"
                                >
                                    {faq.question[currentLanguage]}
                                </span>

                                <span
                                    class="grid size-10 shrink-0 place-items-center rounded-full border border-[color-mix(in_srgb,var(--color-secondary)_28%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-surface)_78%,transparent)] text-[var(--color-secondary)] transition-transform duration-300 group-open:rotate-45 group-open:text-[var(--color-heart)]"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="18"
                                        height="18"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <path d="M12 5v14"></path>
                                        <path d="M5 12h14"></path>
                                    </svg>
                                </span>
                            </summary>

                            <p
                                class="px-[clamp(1rem,2vw,1.2rem)] pb-[clamp(1rem,2vw,1.2rem)] text-[0.98rem] text-[var(--color-text-soft)]"
                            >
                                {faq.answer[currentLanguage]}
                            </p>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section-padding-sm">
        <div class="site-container">
            <div
                class="glow-panel grid items-center gap-5 p-[clamp(1.25rem,3vw,2rem)] max-md:rounded-[1.65rem] lg:grid-cols-[1fr_auto]"
            >
                <div>
                    <span class="section-kicker">
                        {t.appointmentKicker}
                    </span>

                    <h2
                        class="text-[clamp(2rem,4vw,3.75rem)] text-[var(--color-heading)]"
                    >
                        {t.appointmentTitle}
                    </h2>

                    <p
                        class="mt-3 max-w-[720px] text-base text-[var(--color-text-soft)]"
                    >
                        {t.appointmentDescription}
                    </p>
                </div>

                <a
                    href={contactInfo.phone.href}
                    class="btn btn-primary max-lg:w-fit max-md:w-full"
                >
                    {t.callLabel}
                </a>
            </div>
        </div>
    </section>

    <section class="section-padding">
        <div class="site-container">
            <div
                class="mb-[clamp(1.75rem,4vw,3rem)] max-w-[780px]"
            >
                <span class="section-kicker">
                    {t.relatedKicker}
                </span>

                <h2
                    class="text-[clamp(2.25rem,5vw,4.8rem)] text-[var(--color-heading)]"
                >
                    {t.relatedTitle}
                </h2>
            </div>

            <div class="grid gap-4 md:grid-cols-3">
                {
                    relatedServices.map((related, index) => {
                        const RelatedIcon = related.icon;

                        return (
                            <a
                                href={getCardiologyServiceHref(
                                    related,
                                    currentLanguage,
                                )}
                                class:list={[
                                    "medical-card group relative overflow-hidden p-[clamp(1rem,2vw,1.25rem)] text-inherit animate-fade-up",
                                    getAnimationDelayClass(index),
                                ]}
                                aria-label={`${t.exploreService}: ${related.title[currentLanguage]}`}
                            >
                                <div
                                    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--color-secondary)_18%,transparent),transparent_12rem)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                    aria-hidden="true"
                                >
                                </div>

                                <div class="relative z-10">
                                    <span
                                        class="grid size-12 place-items-center rounded-2xl border border-[color-mix(in_srgb,var(--color-secondary)_32%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-surface)_76%,transparent)] p-2 text-[var(--color-secondary)]"
                                    >
                                        <RelatedIcon />
                                    </span>

                                    <h3
                                        class="mt-6 font-heading text-[clamp(1.35rem,2vw,1.85rem)] text-[var(--color-heading)]"
                                    >
                                        {
                                            related.title[
                                                currentLanguage
                                            ]
                                        }
                                    </h3>

                                    <p
                                        class="mt-3 text-sm text-[var(--color-text-soft)]"
                                    >
                                        {
                                            related.shortDescription[
                                                currentLanguage
                                            ]
                                        }
                                    </p>

                                    <span
                                        class="mt-5 inline-flex w-fit items-center gap-2 text-sm font-black text-[var(--color-secondary)] transition-transform duration-300 group-hover:translate-x-1"
                                    >
                                        {t.exploreService}

                                        <svg
                                            viewBox="0 0 24 24"
                                            width="18"
                                            height="18"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            <path d="M5 12h14">
                                            </path>
                                            <path d="m12 5 7 7-7 7">
                                            </path>
                                        </svg>
                                    </span>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </section>
</MainLayout>

<script>
    type ServiceSliderElement = HTMLElement & {
        serviceSliderController?: AbortController;
    };

    const activeSlideClasses = [
        "z-[1]",
        "scale-100",
        "opacity-100",
    ];

    const inactiveSlideClasses = [
        "z-0",
        "scale-105",
        "opacity-0",
    ];

    const activeDotClasses = [
        "scale-x-100",
        "bg-white",
        "opacity-100",
    ];

    const inactiveDotClasses = [
        "scale-x-50",
        "bg-white/45",
        "opacity-60",
    ];

    const toggleClasses = (
        element: HTMLElement,
        classes: string[],
        enabled: boolean,
    ) => {
        classes.forEach((className) => {
            element.classList.toggle(className, enabled);
        });
    };

    const initializeServiceSliders = () => {
        const sliders =
            document.querySelectorAll<ServiceSliderElement>(
                "[data-service-slider]",
            );

        sliders.forEach((slider) => {
            slider.serviceSliderController?.abort();

            const controller = new AbortController();
            slider.serviceSliderController = controller;

            const slides = Array.from(
                slider.querySelectorAll<HTMLElement>(
                    "[data-service-slide]",
                ),
            );

            const dots = Array.from(
                slider.querySelectorAll<HTMLButtonElement>(
                    "[data-service-dot]",
                ),
            );

            if (slides.length === 0) {
                return;
            }

            let activeIndex = 0;
            let intervalId: number | undefined;

            const reducedMotionQuery = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            );

            const setActiveSlide = (nextIndex: number) => {
                activeIndex =
                    (nextIndex + slides.length) % slides.length;

                slides.forEach((slide, index) => {
                    const isActive = index === activeIndex;

                    toggleClasses(
                        slide,
                        activeSlideClasses,
                        isActive,
                    );

                    toggleClasses(
                        slide,
                        inactiveSlideClasses,
                        !isActive,
                    );

                    slide.setAttribute(
                        "aria-hidden",
                        String(!isActive),
                    );
                });

                dots.forEach((dot, index) => {
                    const isActive = index === activeIndex;

                    toggleClasses(
                        dot,
                        activeDotClasses,
                        isActive,
                    );

                    toggleClasses(
                        dot,
                        inactiveDotClasses,
                        !isActive,
                    );

                    dot.setAttribute(
                        "aria-selected",
                        String(isActive),
                    );

                    dot.tabIndex = isActive ? 0 : -1;
                });
            };

            const stopAutoplay = () => {
                if (intervalId === undefined) {
                    return;
                }

                window.clearInterval(intervalId);
                intervalId = undefined;
            };

            const startAutoplay = () => {
                stopAutoplay();

                if (
                    slides.length <= 1 ||
                    reducedMotionQuery.matches
                ) {
                    return;
                }

                intervalId = window.setInterval(() => {
                    setActiveSlide(activeIndex + 1);
                }, 5000);
            };

            dots.forEach((dot, index) => {
                dot.addEventListener(
                    "click",
                    () => {
                        setActiveSlide(index);
                        startAutoplay();
                    },
                    { signal: controller.signal },
                );
            });

            slider.addEventListener(
                "mouseenter",
                stopAutoplay,
                { signal: controller.signal },
            );

            slider.addEventListener(
                "mouseleave",
                startAutoplay,
                { signal: controller.signal },
            );

            slider.addEventListener(
                "focusin",
                stopAutoplay,
                { signal: controller.signal },
            );

            slider.addEventListener(
                "focusout",
                (event) => {
                    const nextTarget = event.relatedTarget;

                    if (
                        !(nextTarget instanceof Node) ||
                        !slider.contains(nextTarget)
                    ) {
                        startAutoplay();
                    }
                },
                { signal: controller.signal },
            );

            reducedMotionQuery.addEventListener(
                "change",
                () => {
                    if (reducedMotionQuery.matches) {
                        stopAutoplay();
                        setActiveSlide(0);
                        return;
                    }

                    startAutoplay();
                },
                { signal: controller.signal },
            );

            controller.signal.addEventListener(
                "abort",
                stopAutoplay,
                { once: true },
            );

            setActiveSlide(0);
            startAutoplay();
        });
    };

    document.addEventListener(
        "astro:page-load",
        initializeServiceSliders,
    );

    initializeServiceSliders();
</script>